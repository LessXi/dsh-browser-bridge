{
  "name": "dsh-browser-bridge",
  "version": "0.2.0",
  "description": "Drive the user's signed-in Chrome from a DSH web session: CDP-backed browser tools, Codex-aligned origin policy, and removable context attachments.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LessXi/dsh-browser-bridge.git",
    "directory": "packages/dsh-browser-bridge"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.5-rc.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "browser",
    "cdp"
  ]
}
